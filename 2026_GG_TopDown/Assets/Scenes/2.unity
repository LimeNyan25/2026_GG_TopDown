  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uC694\uD55C"
    text: "\uC7A0\uC2DC \uAD1C\uCC2E\uB098?"
    playerPortrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: "\uB9C8\uD2F0\uC544\uC2A4"
    text: " \uB124, \uC2E0\uBD80\uB2D8. \uBB34\uC2A8 \uC77C\uC774\uC2ED\uB2C8\uAE4C?"
    playerPortrait: {fileID: 0}
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: "\uC694\uD55C"
    text: "\uC8FC\uAD50\uB2D8\uC758 \uD5C8\uAC00\uB97C \uBC1B\uC558\uB124. \uC800\uD0DD\uC73C\uB85C
      \uC870\uC0AC\uB97C \uB098\uAC08 \uC608\uC815\uC774\uC57C."
    playerPortrait: {fileID: 0}
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: "\uB9C8\uD2F0\uC544\uC2A4"
    text: "\uADF8\uB807\uAD70\uC694! \uD544\uC694\uD55C \uBB3C\uD488\uC740 \uBBF8\uB9AC
      \uCC59\uACA8\uB450\uACA0\uC2B5\uB2C8\uB2E4!"
    playerPortrait: {fileID: 0}
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: "\uB9C8\uD2F0\uC544\uC2A4"
    text: "\uC800\uD0DD\uC73C\uB85C \uC9C0\uAE08 \uBC14\uB85C \uCD9C\uBC1C\uD560\uAE4C\uC694?"
    playerPortrait: {fileID: 0}
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  choice1: "\uC900\uBE44\uB410\uC5B4. \uC9C0\uAE08 \uCD9C\uBC1C\uD558\uC790."
  choice2: "\uC544\uC9C1\uC774\uC57C. \uC900\uBE44\uAC00 \uC548 \uB410\uC5B4"
  onChoice1:
