--- !u!114 &1637242097
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1637242096}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ba067aa92a54bf4fb337a2f114f524e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uC694\uD55C"
    text: "\uC8FC\uAD50\uB2D8, \uC7A0\uC2DC \uB9D0\uC500 \uB098\uB20C \uC218 \uC788\uACA0\uC2B5\uB2C8\uAE4C?"
    playerPortrait: {fileID: 0}
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: "\uBCA0\uB124\uB515\uD1A0"
    text: "\uBB34\uC2A8 \uC77C\uC778\uAC00, \uC694\uD55C? \uACE0\uD574\uC131\uC0AC\uB294
      \uC798 \uB9C8\uCCE4\uB098?"
    playerPortrait: {fileID: 0}
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: "\uC694\uD55C"
    text: "\uC0AC\uC2E4 \uD55C \uBC29\uBB38\uC790\uB85C\uBD80\uD130 \uD2B9\uC774\uD55C
      \uBD80\uD0C1\uC744 \uBC1B\uC558\uC2B5\uB2C8\uB2E4. \uC800\uD0DD\uC5D0 \uAC07\uD78C
      \uC0AC\uB78C\uB4E4\uC744 \uAD6C\uD574\uB2EC\uB77C\uACE0 \uD558\uB354\uAD70\uC694."
    playerPortrait: {fileID: 0}
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: "\uBCA0\uB124\uB515\uD1A0"
    text: "\u2026\uADF8 \uC800\uD0DD\uC774\uB77C\uBA74 \uB9C8\uC744 \uC678\uACFD\uC5D0
      \uC788\uB294 \uC624\uB798\uB41C \uC800\uD0DD\uC744 \uB9D0\uD558\uB294 \uAC74\uAC00?"
    playerPortrait: {fileID: 0}
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: "\uC694\uD55C"
    text: "\uB124. \uBC29\uBB38\uC790\uC758 \uB9D0\uC774 \uBB34\uCC99 \uAC04\uC808\uD588\uC2B5\uB2C8\uB2E4.
      \uC9C1\uC811 \uCC3E\uC544\uAC00 \uD655\uC778\uD574 \uBCF4\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
    playerPortrait: {fileID: 0}
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: "\uBCA0\uB124\uB515\uD1A0"
    text: "\uADF8\uACF3\uC5D0 \uAD00\uD55C \uC18C\uBB38\uC740 \uB098\uB3C4 \uB4E4\uC5B4\uBCF8
      \uC801\uC774 \uC788\uB124. \uC88B\uB124, \uC870\uC0AC\uB97C \uD5C8\uAC00\uD558\uC9C0."
    playerPortrait: {fileID: 0}
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: "\uBCA0\uB124\uB515\uD1A0"
    text: "\uD558\uC9C0\uB9CC \uD63C\uC790 \uC6C0\uC9C1\uC774\uC9C0\uB294 \uB9D0\uAC8C.
      \uB2E4\uB978 \uC0AC\uC81C\uB4E4\uC5D0\uAC8C\uB3C4 \uC5F0\uB77D\uD574 \uB450\uACA0\uB124."
    playerPortrait: {fileID: 0}
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: "\uC694\uD55C"
    text: "\uAC10\uC0AC\uD569\uB2C8\uB2E4, \uC8FC\uAD50\uB2D8."
    playerPortrait: {fileID: 0}
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  choice1: 
  choice2: 
  onChoice1:
    m_PersistentCalls:
      m_Calls: []
  onChoice2:
    m_PersistentCalls:
      m_Calls: []
  onDialogueEnd:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 80297770}
        m_TargetAssemblyTypeName: Talk, Assembly-CSharp
        m_MethodName: Unlock
