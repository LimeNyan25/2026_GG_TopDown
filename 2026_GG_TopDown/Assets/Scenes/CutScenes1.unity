  m_IsActive: 1
--- !u!114 &1654119196
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1654119195}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ba067aa92a54bf4fb337a2f114f524e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: 
    text: "\uC18C\uB9AC\uAC00 \uACE0\uC694\uD558\uB2E4."
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: 
    text: ". . . \uBB38\uC774 \uC5F4\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB09C\uB2E4."
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: "\uC694\uD55C"
    text: "\uB4E4\uC5B4\uC624\uC2ED\uC2DC\uC624. \uBB34\uC2A8 \uC77C\uB85C \uCC3E\uC544\uC624\uC168\uC2B5\uB2C8\uAE4C?"
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: ???
    text: "\u2026\uACE0\uD574\uC131\uC0AC\uB97C \uD558\uB7EC \uC628 \uAC83\uC740
      \uC544\uB2D9\uB2C8\uB2E4."
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: "\uC694\uD55C"
    text: "\uADF8\uB807\uB2E4\uBA74 \uC5B4\uB5A4 \uC77C\uB85C \uC624\uC168\uC2B5\uB2C8\uAE4C?"
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: ??
    text: "\uBD80\uD0C1\uC744 \uB4DC\uB9AC\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4. \uC800\uD0DD\uC5D0
      \uAC07\uD78C \uC0AC\uB78C\uB4E4\uC744 \uAD6C\uD574\uC8FC\uC138\uC694."
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: "\uC694\uD55C"
    text: "\uC800\uD0DD\uC774\uB77C\uBA74\u2026 \uB9C8\uC744 \uC678\uACFD\uC5D0 \uC788\uB294
      \uADF8 \uC624\uB798\uB41C \uC800\uD0DD\uC744 \uB9D0\uC500\uD558\uC2DC\uB294
      \uAC81\uB2C8\uAE4C?"
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: ??
    text: "\uADF8\uB807\uC2B5\uB2C8\uB2E4. \uADF8\uACF3\uC5D0\uB294 \uC544\uC9C1
      \uB5A0\uB098\uC9C0 \uBABB\uD55C \uC0AC\uB78C\uB4E4\uC774 \uC788\uC2B5\uB2C8\uB2E4."
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: "\uC694\uD55C"
    text: "\uADF8\uACF3\uC5D0\uC11C \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB358
      \uAC81\uB2C8\uAE4C?"
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: ??
    text: "\uC624\uB798\uC804\uBD80\uD130 \uB9CE\uC740 \uC77C\uC774 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.
      \uADF8\uB9AC\uACE0 \uADF8 \uC77C\uB4E4\uC740 \uC544\uC9C1 \uB05D\uB098\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    portrait: {fileID: 7199705072138568028, guid: a64e455a2f789d2468b5f37a83ad83e4, type: 3}
  - speaker: "\uC694\uD55C"
    text: "\uC9C1\uC811 \uB3C4\uC6C0\uC744 \uC694\uCCAD\uD560 \uC218\uBC16\uC5D0
      \uC5C6\uC744 \uB9CC\uD07C \uC2EC\uAC01\uD55C \uC0C1\uD669\uC774\uB77C\uB294
      \uB9D0\uC500\uC774\uAD70\uC694."
    portrait: {fileID: 720118652224413485, guid: 93ca0e91a00886e46b79c138c02cd4a9, type: 3}
  - speaker: ??
    text: "\u2026\uC800\uB294 \uADF8\uACF3\uC744 \uBC97\uC5B4\uB0A0 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uD558\uC9C0\uB9CC \uB2E4\uB978 \uC774\uB4E4\uBCF4\uB2E4\uB294 \uC870\uAE08
      \uB354 \uC790\uC720\uB86D\uAC8C \uC6C0\uC9C1\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    portrait: {fileID: 720118652224413485, guid: 93ca0e91a00886e46b79c138c02cd4a9, type: 3}
  - speaker: "\uC694\uD55C"
    text: "\uB2F9\uC2E0\uC740 \uB300\uCCB4 \uB204\uAD6C\uC2ED\uB2C8\uAE4C? \uC5B4\uC9F8\uC11C
      \uADF8\uACF3\uC5D0\u2014"
    portrait: {fileID: 720118652224413485, guid: 93ca0e91a00886e46b79c138c02cd4a9, type: 3}
  - speaker: ??
    text: "\uBD80\uB514 \uADF8\uACF3\uC5D0 \uB0A8\uACA8\uC9C4 \uC0AC\uB78C\uB4E4\uC744
      \uC678\uBA74\uD558\uC9C0 \uB9D0\uC544 \uC8FC\uC138\uC694."
    portrait: {fileID: 720118652224413485, guid: 93ca0e91a00886e46b79c138c02cd4a9, type: 3}
